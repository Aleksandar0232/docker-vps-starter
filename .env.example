# Copy this file to .env and adjust it:   cp .env.example .env
# Docker Compose reads .env automatically. .env is in .gitignore, so your
# real settings never end up on GitHub.

# Port on the SERVER that nginx listens on.
# cPanel's Apache already uses 80 and 443, so don't use those here.
HOST_PORT=8080

# Which server IP to listen on:
#   0.0.0.0   = reachable from the internet at http://YOUR-SERVER-IP:8080
#   127.0.0.1 = only reachable from the server itself
#               (use this when Apache reverse-proxies a real domain to it)
BIND_IP=0.0.0.0

# Title shown on the page
APP_TITLE=Docker VPS Starter

# Timezone used by the app (e.g. Europe/Belgrade, America/New_York)
TZ=UTC
